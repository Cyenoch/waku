{
  "name": "wakuwaku-workspace",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "release": "bun ./scripts/release.ts",
    "protocol:generate": "cargo run -p wakuwaku-protocol --bin export_types",
    "protocol:check": "cargo run -p wakuwaku-protocol --bin export_types -- --check",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "private": true,
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "workspaces": ["website", "apps/*", "packages/*"]
}
